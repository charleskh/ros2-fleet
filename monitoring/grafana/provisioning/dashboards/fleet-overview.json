{
  "uid": "fleet-overview",
  "title": "Fleet \u2014 Hyperion Perception (live robot)",
  "tags": [
    "fleet",
    "robotics",
    "m6"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
